// Event graph of the ER triage model. Generated by src/event_graph.py;
// render: dot -Kneato -Tpng -Gdpi=300 figures/event_graph.dot -o figures/event_graph.png
digraph ER_event_graph {
  graph [layout=neato, splines=curved, fontname="Helvetica", pad=0.4, bgcolor="white", labelloc=t, fontsize=20, label=<<B>ER triage simulation — event graph</B>>, fontcolor="#1f2933"];
  node [fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=13];
  Run [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B><FONT POINT-SIZE="15" COLOR="#1f2933">Run</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">Q_T = 0, Q_R = 0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">S_N = 0, S_R = 0</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#e4e7eb", color="#1f2933", penwidth=1.4, margin="0.15,0.08"];
  Arrival [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B><FONT POINT-SIZE="15" COLOR="#1f2933">Arrival</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">Q_T = Q_T + 1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">draw severity</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#1f2933", penwidth=1.4, margin="0.15,0.08"];
  TriageStart [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B><FONT POINT-SIZE="15" COLOR="#1f2933">Triage Start</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">Q_T = Q_T − 1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">S_N = 1</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#1f2933", penwidth=1.4, margin="0.15,0.08"];
  TriageEnd [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B><FONT POINT-SIZE="15" COLOR="#1f2933">Triage End</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">S_N = 0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">Q_R = Q_R + 1</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#1f2933", penwidth=1.4, margin="0.15,0.08"];
  TreatStart [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B><FONT POINT-SIZE="15" COLOR="#1f2933">Treatment Start</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">Q_R = Q_R − 1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">S_R = S_R + 1</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#1f2933", penwidth=1.4, margin="0.15,0.08"];
  TreatEnd [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B><FONT POINT-SIZE="15" COLOR="#1f2933">Treatment End</FONT></B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#52606d">S_R = S_R − 1</FONT></TD></TR></TABLE>>, shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#1f2933", penwidth=1.4, margin="0.15,0.08"];
  legend [shape=plaintext, fontsize=12, label=<<TABLE BORDER="1" COLOR="#cbd2d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f2933"><B>State variables</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">Q_T  patients waiting for triage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">Q_R  patients waiting for a room</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">S_N  nurse busy (0 or 1)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">S_R  rooms busy (0 … R), R = 4, 6 or 8</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1f2933"><B>Delays</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">t<sub>a</sub> ~ Exp(mean 3 or 6 min)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">t<sub>triage</sub> ~ Tri(min 2, mode 4, max 6)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">t<sub>treat</sub> ~ N(15, 3) low · N(25, 5) medium · N(45, 8) high</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">severity ~ low .5 · medium .3 · high .2</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1f2933"><B>Edges</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">solid: schedule after the delay shown</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">dashed: delay 0 (same instant)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52606d">(…): only if the condition holds when the tail event happens</FONT></TD></TR></TABLE>>];
  Run [pos="0.0,3.2!"];
  Arrival [pos="3.4,3.2!"];
  TriageStart [pos="7.2,3.2!"];
  TriageEnd [pos="11.0,3.2!"];
  TreatStart [pos="11.0,0.0!"];
  TreatEnd [pos="6.6,0.0!"];
  legend [pos="1.6,0.0!"];
  Run -> Arrival [label=<<FONT COLOR="#0b6e99"><B>t<sub>a</sub></B></FONT>>, style=solid, color="#3e4c59", penwidth=1.3, arrowsize=0.8];
  Arrival -> Arrival [label=<<FONT COLOR="#0b6e99"><B>t<sub>a</sub></B></FONT>>, style=solid, color="#3e4c59", penwidth=1.3, arrowsize=0.8, tailport=ne, headport=nw];
  Arrival -> TriageStart [label=<<FONT COLOR="#1f2933">(S_N = 0)</FONT>>, style=dashed, color="#3e4c59", penwidth=1.3, arrowsize=0.8, tailport=e, headport=w];
  TriageStart -> TriageEnd [label=<<FONT COLOR="#0b6e99"><B>t<sub>triage</sub></B></FONT>>, style=solid, color="#3e4c59", penwidth=1.3, arrowsize=0.8, tailport=ne, headport=nw];
  TriageEnd -> TriageStart [label=<<FONT COLOR="#1f2933">(Q_T &gt; 0)</FONT>>, style=dashed, color="#3e4c59", penwidth=1.3, arrowsize=0.8, tailport=sw, headport=se];
  TriageEnd -> TreatStart [label=<<FONT COLOR="#1f2933">(S_R &lt; R)</FONT>>, style=dashed, color="#3e4c59", penwidth=1.3, arrowsize=0.8];
  TreatStart -> TreatEnd [label=<<FONT COLOR="#0b6e99"><B>t<sub>treat</sub></B></FONT>>, style=solid, color="#3e4c59", penwidth=1.3, arrowsize=0.8, tailport=sw, headport=se];
  TreatEnd -> TreatStart [label=<<FONT COLOR="#1f2933">(Q_R &gt; 0)</FONT>>, style=dashed, color="#3e4c59", penwidth=1.3, arrowsize=0.8, tailport=ne, headport=nw];
}
